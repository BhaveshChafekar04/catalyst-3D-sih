# PostgreSQL connection string for the backend only.
# Replace the placeholders locally; do not commit backend/.env.
# URL-encode reserved characters in the password (for example: @, :, /, #, [, ]).
DATABASE_URL=postgresql://postgres:<YOUR-PASSWORD>@<YOUR-SUPABASE-HOST>:5432/postgres

# AI API Key (To be implemented in Phase 3)
AI_API_KEY=your_ai_api_key_here
